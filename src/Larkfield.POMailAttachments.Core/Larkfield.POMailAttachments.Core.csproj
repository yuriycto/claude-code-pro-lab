<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain .NET logic with no Acumatica references, so it builds and is unit tested on any machine.
    The Acumatica project compiles these same sources into its own assembly.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Larkfield.POMailAttachments</RootNamespace>
    <AssemblyName>Larkfield.POMailAttachments.Core</AssemblyName>
  </PropertyGroup>

</Project>
